{
    "name": "pieceofcake2/seo",
    "description": "CakePHP 2 Search Engine Optimization Plugin",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "seo"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.10"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.1",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "replace": {
        "webtechnick/cakephp-seo-plugin": "^6.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Seo"
    }
}
